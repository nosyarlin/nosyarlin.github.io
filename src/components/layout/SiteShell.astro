---
import { MobileNav } from "@/components/layout/mobile-nav";
import { ThemeToggle } from "@/components/ui/theme-toggle";
import { cn } from "@/lib/cn";
import { NAV_ITEMS, SITE, isNavActive } from "@/lib/site";

const currentPath = Astro.url.pathname;

const navBase =
  "px-3 py-2 text-sm font-medium text-neutral-600 transition hover:text-neutral-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:text-neutral-300 dark:hover:text-neutral-50 dark:ring-offset-neutral-900";
const navActive =
  "text-primary underline underline-offset-8 decoration-primary decoration-2 dark:text-neutral-50";
const footerLink =
  "text-neutral-600 hover:text-primary dark:text-neutral-400 dark:hover:text-primary-200";
---

<div
  class="flex min-h-screen bg-neutral-50 text-neutral-900 dark:bg-neutral-950 dark:text-neutral-50"
>
  <div class="flex min-w-0 flex-1 flex-col">
    <header class="bg-neutral-50 px-6 pt-3 dark:bg-neutral-950" role="banner">
      <div
        class="mx-auto flex h-14 w-full max-w-6xl items-center gap-2 md:gap-3"
      >
        <MobileNav client:media="(max-width: 767px)" currentPath={currentPath} />

        <div class="min-w-0 shrink pr-1">
          <a
            href="/"
            class="block truncate font-semibold tracking-tight text-neutral-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:text-neutral-50 dark:ring-offset-neutral-900"
          >
            {SITE.name}
          </a>
          <p class="truncate text-xs text-neutral-500 dark:text-neutral-400">
            {SITE.tagline}
          </p>
        </div>
        <div class="flex-1"></div>
        <nav class="hidden items-center gap-1 md:flex" aria-label="Main">
          {
            NAV_ITEMS.map((item) => {
              const active = isNavActive(currentPath, item.href, item.end);
              return (
                <a
                  href={item.href}
                  class={cn(navBase, active && navActive)}
                  aria-current={active ? "page" : undefined}
                >
                  {item.label}
                </a>
              );
            })
          }
        </nav>
        <ThemeToggle client:load className="h-11 w-11 shrink-0" />
      </div>
    </header>

    <main class="flex-1 overflow-auto px-6 md:px-10" id="main-content">
      <slot />
    </main>

    <footer
      class="border-t border-neutral-200 px-6 py-6 dark:border-neutral-700 md:px-10"
    >
      <div class="mx-auto w-full max-w-6xl">
        <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
          <a href={SITE.links.linkedin} class={footerLink}>LinkedIn</a>
          <a href={SITE.links.github} class={footerLink}>Github</a>
          <a href="/rss.xml" class={footerLink}>RSS</a>
        </div>
        <p class="mt-3 text-xs text-neutral-500 dark:text-neutral-400">
          © {new Date().getFullYear()} Rayson Lim. All rights reserved.
        </p>
      </div>
    </footer>
  </div>
</div>
