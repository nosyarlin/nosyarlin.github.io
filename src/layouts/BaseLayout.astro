---
import "@/index.css";
import SiteShell from "@/components/layout/SiteShell.astro";
import { SITE } from "@/lib/site";
import { THEME_STORAGE_KEY } from "@/lib/theme";

export type Props = {
  /** Page title without the site suffix; omit on the home page. */
  title?: string;
  description?: string;
  /** Absolute or root-relative URL of a 1200×630 preview image. */
  image?: string;
  imageAlt?: string;
  type?: "website" | "article";
  publishedTime?: string;
  tags?: string[];
  /** Extra JSON-LD objects for this page. */
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
};

const {
  title,
  description = SITE.description,
  image = "/og/default.png",
  imageAlt,
  type = "website",
  publishedTime,
  tags = [],
  jsonLd = [],
  noindex = false,
} = Astro.props;

const fullTitle = title ? `${title} | ${SITE.name}` : SITE.name;
const site = Astro.site ?? new URL("https://raysonlim.com");
const canonical = new URL(
  Astro.url.pathname.replace(/\.html$/, "").replace(/(.)\/+$/, "$1"),
  site,
).href;
const imageUrl = new URL(image, site).href;
const publishedIso = publishedTime
  ? new Date(publishedTime).toISOString()
  : undefined;

const themeScript = `(function(){try{var t=localStorage.getItem(${JSON.stringify(THEME_STORAGE_KEY)});if(t!=="light"&&t!=="dark"){t=matchMedia("(prefers-color-scheme: dark)").matches?"dark":"light"}var d=document.documentElement;d.classList.toggle("dark",t==="dark");d.dataset.theme=t}catch(e){}})();`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline set:html={themeScript} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? SITE.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt ?? title ?? SITE.name} />
    <meta property="og:locale" content="en_US" />
    {
      type === "article" && publishedIso && (
        <meta property="article:published_time" content={publishedIso} />
      )
    }
    {
      type === "article" && (
        <meta property="article:author" content={SITE.author} />
      )
    }
    {
      type === "article" &&
        tags.map((tag) => <meta property="article:tag" content={tag} />)
    }

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? SITE.name} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <link rel="icon" type="image/png" href="/favicon-32x32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon-16x16.png" sizes="16x16" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE.name} RSS`}
      href="/rss.xml"
    />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {
      jsonLd.map((data) => (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(data)}
        />
      ))
    }
  </head>
  <body>
    <SiteShell>
      <slot />
    </SiteShell>
  </body>
</html>
